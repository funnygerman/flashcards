{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node"],

    /* Resolve straight to source, the same way vitest.config.ts already does
       for tests, so this typecheck needs library/dist to exist. Typechecking
       against source is at least as accurate as against generated .d.ts, so
       this loses nothing — it only drops the requirement that `npm run build`
       has already run. */
    "paths": {
      "@flashcards/library": ["./library/src/index.ts"]
    }
  },
  "include": ["library/src/**/*.ts", "app/src/**/*.ts", "scripts/**/*.mjs", "*.config.ts"]
}
